{
  "name": "sales-order-report",
  "version": "1.0.0",
  "description": "Open Sales Orders report - SAP CAP + UI5",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "verify": "node scripts/verify.js"
  },
  "dependencies": {
    "@sap/cds": "10.1.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "3.1.1",
    "@sap/cds-dk": "10.1.2"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    }
  }
}
